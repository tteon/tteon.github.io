---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('experiments');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const dateStr = d.date.toISOString().slice(0, 10);

const verdictBadge: Record<string, string> = {
  Supported: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300',
  Refuted: 'border-rose-500/40 bg-rose-500/10 text-rose-700 dark:text-rose-300',
  Mixed: 'border-amber-500/40 bg-amber-500/10 text-amber-700 dark:text-amber-300',
  Inconclusive: 'border-zinc-500/40 bg-zinc-500/10 text-zinc-600 dark:text-zinc-400',
};
---

<BaseLayout title={`${d.title} — Experiment Log`} description={d.summary}>
  <div class="mb-6">
    <a href="/experiments/" class="font-mono text-xs text-cyan-700 dark:text-cyan-400 hover:underline">← Back to Experiment Log</a>
  </div>

  <article>
    <header class="mb-8 pb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
        <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-zinc-500 dark:text-zinc-400">
          <span>{dateStr}</span>
          <span>·</span>
          <span>Host: {d.host}</span>
          {d.beadsId && (
            <>
              <span>·</span>
              <span>Beads: {d.beadsId}</span>
            </>
          )}
          {d.commit && (
            <>
              <span>·</span>
              <span>Commit: {d.commit}</span>
            </>
          )}
        </div>
        <span class={`rounded-full border px-2.5 py-0.5 font-mono text-xs font-medium ${verdictBadge[d.verdict]}`}>
          {d.verdict}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-950 dark:text-white mb-4">
        {d.title}
      </h1>

      <div class="rounded-xl border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900/50 p-4 space-y-3 text-xs sm:text-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400">Pre-Registered Hypothesis</span>
            <p class="text-zinc-800 dark:text-zinc-200 mt-1">{d.hypothesis}</p>
          </div>
          <div>
            <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400">Verdict & Headline Metric</span>
            <p class="text-zinc-800 dark:text-zinc-200 mt-1">
              <strong class="font-mono text-cyan-700 dark:text-cyan-300">{d.verdict}</strong> —{' '}
              <span class="font-mono tabular-nums">{d.keyMetric}</span>
            </p>
          </div>
        </div>
        {d.falsification && (
          <div class="pt-3 border-t border-zinc-200/70 dark:border-zinc-800/80">
            <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400">Falsification Criteria</span>
            <p class="text-zinc-700 dark:text-zinc-300 mt-1">{d.falsification}</p>
          </div>
        )}
      </div>

      {d.environment && (
        <div class="mt-3 rounded-xl border border-zinc-200/80 dark:border-zinc-800/80 bg-zinc-100/70 dark:bg-zinc-950/60 p-4">
          <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-500 dark:text-zinc-400">
            Environment & Reproducibility Manifest
          </span>
          <dl class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-xs font-mono">
            {d.environment.machine && (
              <div>
                <dt class="text-zinc-400">Host / Compute</dt>
                <dd class="text-zinc-800 dark:text-zinc-200">{d.environment.machine}</dd>
              </div>
            )}
            {d.environment.runtime && (
              <div>
                <dt class="text-zinc-400">Runtime / Engines</dt>
                <dd class="text-zinc-800 dark:text-zinc-200">{d.environment.runtime}</dd>
              </div>
            )}
            {d.environment.dataset && (
              <div>
                <dt class="text-zinc-400">Workload / Dataset</dt>
                <dd class="text-zinc-800 dark:text-zinc-200">{d.environment.dataset}</dd>
              </div>
            )}
            {d.environment.repeats && (
              <div>
                <dt class="text-zinc-400">Sample Size / Repeats</dt>
                <dd class="text-zinc-800 dark:text-zinc-200">{d.environment.repeats}</dd>
              </div>
            )}
            {d.environment.artifactSha256 && (
              <div class="sm:col-span-2">
                <dt class="text-zinc-400">Artifact Checksum / Integrity</dt>
                <dd class="text-zinc-800 dark:text-zinc-200 break-all">{d.environment.artifactSha256}</dd>
              </div>
            )}
          </dl>
        </div>
      )}

      {d.repoUrl && (
        <div class="mt-3 font-mono text-xs">
          <a href={d.repoUrl} target="_blank" rel="noreferrer" class="text-cyan-700 dark:text-cyan-400 hover:underline">
            Source Repository ↗
          </a>
        </div>
      )}
    </header>

    {d.figures.length > 0 && (
      <section class="mb-8 space-y-5">
        {d.figures.map((fig) => (
          <figure class="paper-figure">
            <img src={fig.src} alt={fig.alt} loading="eager" />
            <figcaption>{fig.caption}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <div class="prose-custom">
      <Content />
    </div>
  </article>
</BaseLayout>
