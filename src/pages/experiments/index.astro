---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExperimentCard from '../../components/ExperimentCard.astro';
import { getCollection } from 'astro:content';

const experiments = (await getCollection('experiments'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const verdicts = ['All', 'Supported', 'Refuted', 'Mixed', 'Inconclusive'];
---

<BaseLayout title="Experiment Log — Yitae Jeong" description="Hypothesis-driven systems and GraphRAG experiment logs with raw artifact verification.">
  <div class="mb-7 max-w-2xl">
    <p class="font-mono text-xs text-blue-800 dark:text-cyan-400 mb-2">LAB JOURNAL / REPRODUCIBLE EVIDENCE</p>
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-stone-950 dark:text-white mb-2">Experiment Log</h1>
    <p class="text-sm sm:text-base text-stone-600 dark:text-zinc-400 leading-relaxed">
      Each post pairs pre-registered falsification criteria, raw artifacts, and publication figures with practical takeaways. Execution failures are always marked Inconclusive.
    </p>
  </div>

  <div class="flex flex-wrap gap-2 mb-4" id="verdict-filters">
    {verdicts.map((v, idx) => (
      <button
        type="button"
        data-filter={v}
        class={`filter-btn rounded-full border px-3 py-1 font-mono text-xs transition-colors ${
          idx === 0
            ? 'border-blue-700 bg-blue-700/10 text-blue-800 dark:border-cyan-500 dark:bg-cyan-500/15 dark:text-cyan-300'
            : 'border-stone-300 dark:border-zinc-700 text-stone-600 dark:text-zinc-400 hover:border-stone-500'
        }`}
      >
        {v}
      </button>
    ))}
  </div>

  <div id="exp-list" class="max-w-4xl">
    {experiments.map((exp) => (
      <ExperimentCard slug={exp.id} {...exp.data} />
    ))}
  </div>

  <script is:inline>
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.exp-card');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-filter');
        buttons.forEach((b) => {
          b.className = 'filter-btn rounded-full border px-3 py-1 font-mono text-xs transition-colors border-stone-300 dark:border-zinc-700 text-stone-600 dark:text-zinc-400 hover:border-stone-500';
        });
        btn.className = 'filter-btn rounded-full border px-3 py-1 font-mono text-xs transition-colors border-blue-700 bg-blue-700/10 text-blue-800 dark:border-cyan-500 dark:bg-cyan-500/15 dark:text-cyan-300';
        cards.forEach((card) => {
          const v = card.getAttribute('data-verdict');
          card.style.display = target === 'All' || v === target ? 'block' : 'none';
        });
      });
    });
  </script>
</BaseLayout>
