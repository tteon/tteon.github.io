---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import { getCollection } from 'astro:content';

const experiments = (await getCollection('experiments'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const writings = (await getCollection('writing'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const projects = [
  {
    name: 'SEOCHO',
    desc: 'Ontology-first graph memory and runtime for agents — separating semantic validation, Bolt scheduling, and multi-engine query execution.',
    url: 'https://seocho.blog',
    repo: 'https://github.com/tteon/seocho',
    tag: 'GraphRAG · Ontology · Runtime',
  },
  {
    name: 'Auto-Ontology Bench',
    desc: 'Paired statistical evaluation across Postgres and Neo4j measuring when ontology grounding lifts or degrades multi-tier retrieval accuracy.',
    url: 'https://github.com/tteon/auto-ontology-bench',
    repo: 'https://github.com/tteon/auto-ontology-bench',
    tag: 'Benchmark · Evaluation',
  },
  {
    name: 'GARE2E & FinBench',
    desc: 'End-to-end replay, serialization probes, and SHA-256-verified evidence pipelines for graph-agentic financial RAG.',
    url: 'https://github.com/tteon/gare2e',
    repo: 'https://github.com/tteon/gare2e',
    tag: 'Reproducibility · Audit',
  },
  {
    name: 'KV-Cache & Systems Lab',
    desc: 'Experiments on tiered KV-cache offloading, vLLM execution traces, CXL memory, and multi-agent shared memory architectures.',
    url: 'https://github.com/tteon/kvcache-lab',
    repo: 'https://github.com/tteon/kvcache-lab',
    tag: 'vLLM · KV-Cache · CXL',
  },
];
---

<BaseLayout title="Yitae Jeong (tteon) — Systems & Graph AI Research">
  <section class="pb-12 border-b border-zinc-200 dark:border-zinc-800/80">
    <p class="font-mono text-xs text-cyan-700 dark:text-cyan-400 mb-3">
      Yitae Jeong · XCENA · Seoul
    </p>
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-zinc-950 dark:text-white leading-tight mb-4">
      Exploring the intersection of Graph Processing, Ontology-First Agents, KV-Cache, and CXL.
    </h1>
    <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed mb-6">
      Research notes, reproducible experiment logs, and systems engineering work across graph database runtimes, ontology-guided agent memory, and LLM serving infrastructure. Every experiment entry separates verified measurements from open hypotheses.
    </p>
    <div class="flex flex-wrap gap-3 font-mono text-xs">
      <a href="/experiments/" class="rounded-lg bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-950 px-3.5 py-2 font-medium hover:opacity-90 transition-opacity">
        Browse Experiment Log →
      </a>
      <a href="https://github.com/tteon" target="_blank" rel="noreferrer" class="rounded-lg border border-zinc-300 dark:border-zinc-700 px-3.5 py-2 text-zinc-700 dark:text-zinc-300 hover:border-zinc-500 transition-colors">
        GitHub (@tteon)
      </a>
      <a href="https://seocho.blog" target="_blank" rel="noreferrer" class="rounded-lg border border-zinc-300 dark:border-zinc-700 px-3.5 py-2 text-zinc-700 dark:text-zinc-300 hover:border-zinc-500 transition-colors">
        SEOCHO Docs ↗
      </a>
      <a href="https://www.linkedin.com/in/yitaejeong/" target="_blank" rel="noreferrer" class="rounded-lg border border-zinc-300 dark:border-zinc-700 px-3.5 py-2 text-zinc-700 dark:text-zinc-300 hover:border-zinc-500 transition-colors">
        LinkedIn ↗
      </a>
    </div>
  </section>

  <section class="py-10 border-b border-zinc-200 dark:border-zinc-800/80 grid grid-cols-1 md:grid-cols-3 gap-5">
    <div class="rounded-xl border border-zinc-200 dark:border-zinc-800/80 p-4 bg-white/70 dark:bg-zinc-900/30">
      <span class="font-mono text-[11px] text-cyan-700 dark:text-cyan-400">01 / GRAPH RUNTIME</span>
      <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mt-1 mb-1.5">Bolt & Execution Routing</h2>
      <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Rust query-scheduling middleware, admission control, and workload-aware routing across Slotted, Pipelined, and Parallel graph runtimes.
      </p>
    </div>
    <div class="rounded-xl border border-zinc-200 dark:border-zinc-800/80 p-4 bg-white/70 dark:bg-zinc-900/30">
      <span class="font-mono text-[11px] text-cyan-700 dark:text-cyan-400">02 / ONTOLOGY MEMORY</span>
      <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mt-1 mb-1.5">Federated Ontology Agents</h2>
      <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Preventing context contamination in multi-domain knowledge graphs via competency-driven ontology grounding and paired ablation studies.
      </p>
    </div>
    <div class="rounded-xl border border-zinc-200 dark:border-zinc-800/80 p-4 bg-white/70 dark:bg-zinc-900/30">
      <span class="font-mono text-[11px] text-cyan-700 dark:text-cyan-400">03 / SERVING & CXL</span>
      <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 mt-1 mb-1.5">KV-Cache & Memory Hierarchy</h2>
      <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
        Characterizing agentic GraphCoT prefill/decode traces, KV-cache sharing across shared ontology memory, and CXL/RDMA transfer trade-offs.
      </p>
    </div>
  </section>

  <section class="py-10 border-b border-zinc-200 dark:border-zinc-800/80">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-950 dark:text-white">Recent Experiment Logs</h2>
      <a href="/experiments/" class="font-mono text-xs text-cyan-700 dark:text-cyan-400 hover:underline">All experiments →</a>
    </div>
    <div class="space-y-4">
      {experiments.map((exp) => (
        <ExperimentCard slug={exp.id} {...exp.data} />
      ))}
    </div>
  </section>

  <section class="py-10 border-b border-zinc-200 dark:border-zinc-800/80">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-950 dark:text-white">Technical Writing</h2>
      <a href="/writing/" class="font-mono text-xs text-cyan-700 dark:text-cyan-400 hover:underline">All notes →</a>
    </div>
    <div class="space-y-3">
      {writings.map((post) => (
        <a href={`/writing/${post.id}/`} class="block rounded-xl border border-zinc-200 dark:border-zinc-800/80 p-4 hover:border-cyan-500/50 transition-colors bg-white/70 dark:bg-zinc-900/30">
          <div class="flex items-center gap-2 font-mono text-xs text-zinc-500 dark:text-zinc-400 mb-1">
            <span>{post.data.date.toISOString().slice(0, 10)}</span>
            <span>·</span>
            <span>{post.data.category}</span>
            <span>·</span>
            <span>{post.data.readingTime}</span>
          </div>
          <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 mb-1">{post.data.title}</h3>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">{post.data.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="pt-10">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-semibold tracking-tight text-zinc-950 dark:text-white">Selected Systems & Benchmarks</h2>
      <a href="/projects/" class="font-mono text-xs text-cyan-700 dark:text-cyan-400 hover:underline">Projects & talks →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {projects.map((p) => (
        <a href={p.url} target="_blank" rel="noreferrer" class="rounded-xl border border-zinc-200 dark:border-zinc-800/80 p-4 bg-white/70 dark:bg-zinc-900/30 hover:border-cyan-500/50 transition-colors">
          <div class="flex items-center justify-between mb-1.5">
            <h3 class="font-semibold text-sm text-zinc-900 dark:text-zinc-100">{p.name}</h3>
            <span class="font-mono text-[11px] text-zinc-400">↗</span>
          </div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed mb-2.5">{p.desc}</p>
          <span class="font-mono text-[11px] text-cyan-700 dark:text-cyan-400">{p.tag}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
