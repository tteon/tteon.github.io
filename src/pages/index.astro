---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperimentCard from '../components/ExperimentCard.astro';
import { getCollection } from 'astro:content';
import { EXPERIMENT_CATEGORIES } from '../content.config';

const experiments = (await getCollection('experiments'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const catSummary = EXPERIMENT_CATEGORIES.map((name) => ({
  name,
  count: experiments.filter((e) => e.data.category === name).length,
}));

const writings = (await getCollection('writing'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

function estReadTime(body?: string): string {
  const words = (body || '').trim().split(/\s+/).filter(Boolean).length;
  return `${Math.max(1, Math.round(words / 200))} min read`;
}

const systems = [
  {
    name: 'SEOCHO',
    desc: 'Ontology-first graph memory & multi-engine agent runtime.',
    href: '/about/#seocho',
    external: false,
    tag: 'GraphRAG · Ontology · Runtime',
  },
  {
    name: 'Auto-Ontology Bench',
    desc: '1,600-request paired McNemar suite across Postgres and Neo4j.',
    href: 'https://github.com/tteon/auto-ontology-bench',
    external: true,
    tag: 'Benchmark · SQL/Cypher',
  },
  {
    name: 'GARE2E & FinBench',
    desc: 'SHA-256-verified graph RAG audit and DB replay harnesses.',
    href: 'https://github.com/tteon/gare2e',
    external: true,
    tag: 'Reproducibility · Audit',
  },
  {
    name: 'KV-Cache & BDI Agents',
    desc: 'Multi-agent BDI RDF orchestration, Beads tracking, vLLM traces, and analytical CXL/RDMA notes.',
    href: '/experiments/2026-11-24-bdi-agent-ontology-beads-synergy/',
    external: false,
    tag: 'BDI · Beads · Serving',
  },
];
---

<BaseLayout title="Yitae Jeong (tteon) — Systems & Graph AI Research">
  <section class="pb-10 border-b border-stone-200 dark:border-zinc-800/80 max-w-3xl">
    <p class="font-mono text-xs text-blue-800 dark:text-cyan-400 mb-3">
      Yitae Jeong · XCENA · Seoul
    </p>
    <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-stone-950 dark:text-white leading-[1.18] mb-4">
      Systems notes &amp; reproducible experiments on graph runtimes, ontology agents, and LLM serving.
    </h1>
    <p class="text-base text-stone-600 dark:text-zinc-400 leading-relaxed mb-6">
      Every post pairs an architecture diagram or publication plot with raw artifact verification, explicit failure boundaries, and practical engineering takeaways.
    </p>
    <div class="flex flex-wrap gap-3 font-mono text-xs">
      <a href="/experiments/" class="rounded-lg bg-stone-900 text-white dark:bg-zinc-100 dark:text-zinc-950 px-4 py-2 font-medium hover:opacity-90 transition-opacity">
        Browse Experiments →
      </a>
      <a href="/writing/" class="rounded-lg border border-stone-300 dark:border-zinc-700 px-4 py-2 text-stone-700 dark:text-zinc-300 hover:border-stone-500 transition-colors">
        Architecture Notes
      </a>
      <a href="/about/" class="rounded-lg border border-stone-300 dark:border-zinc-700 px-4 py-2 text-stone-700 dark:text-zinc-300 hover:border-stone-500 transition-colors">
        About
      </a>
    </div>
  </section>

  <section class="py-10 border-b border-stone-200 dark:border-zinc-800/80">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-2">
      <h2 class="text-xl font-semibold tracking-tight text-stone-950 dark:text-white">Experiment Log by Category</h2>
      <div class="flex items-center gap-4 font-mono text-xs">
        <a href="/archive/" class="text-stone-600 dark:text-zinc-300 hover:underline">Full Local Catalog &amp; Backlog →</a>
        <a href="/experiments/" class="text-blue-800 dark:text-cyan-400 hover:underline">Filter by category / verdict →</a>
      </div>
    </div>
    <p class="text-sm text-stone-500 dark:text-zinc-400 mb-4">
      Measured runs grounded in preserved manifests, paired statistics, and honest failure boundaries.
    </p>
    <div class="flex flex-wrap gap-2 mb-5">
      {catSummary.map((c) => (
        <a
          href={`/experiments/?category=${encodeURIComponent(c.name)}`}
          class="rounded-lg border border-stone-200 dark:border-zinc-800 bg-white/70 dark:bg-zinc-900/40 px-2.5 py-1 font-mono text-xs text-stone-700 dark:text-zinc-300 hover:border-blue-600 dark:hover:border-cyan-400 transition-colors"
        >
          {c.name} <span class="text-stone-400">({c.count})</span>
        </a>
      ))}
    </div>
    <div>
      {experiments.slice(0, 6).map((exp) => (
        <ExperimentCard slug={exp.id} {...exp.data} />
      ))}
    </div>
    {experiments.length > 6 && (
      <div class="pt-5">
        <a href="/experiments/" class="font-mono text-xs text-blue-800 dark:text-cyan-400 hover:underline">
          View all {experiments.length} published experiment logs →
        </a>
      </div>
    )}
  </section>

  <section class="py-10 border-b border-stone-200 dark:border-zinc-800/80">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-xl font-semibold tracking-tight text-stone-950 dark:text-white">Technical Writing</h2>
      <a href="/writing/" class="font-mono text-xs text-blue-800 dark:text-cyan-400 hover:underline">All notes →</a>
    </div>
    <div class="divide-y divide-stone-200/80 dark:divide-zinc-800/80">
      {writings.map((post) => (
        <a href={`/writing/${post.id}/`} class="group block py-4 hover:bg-stone-100/50 dark:hover:bg-zinc-900/35 -mx-3 px-3 rounded-xl transition-colors">
          <div class="flex items-center gap-2 font-mono text-xs text-stone-500 dark:text-zinc-400 mb-1">
            <span>{post.data.date.toISOString().slice(0, 10)}</span>
            <span>·</span>
            <span>{post.data.category}</span>
            <span>·</span>
            <span>{estReadTime(post.body)}</span>
          </div>
          <h3 class="text-base sm:text-lg font-semibold text-stone-900 dark:text-zinc-100 group-hover:text-blue-800 dark:group-hover:text-cyan-300 transition-colors mb-1">
            {post.data.title}
          </h3>
          <p class="text-sm text-stone-600 dark:text-zinc-400 leading-relaxed">{post.data.summary}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="pt-10">
    <div class="flex items-baseline justify-between mb-4">
      <h2 class="text-xl font-semibold tracking-tight text-stone-950 dark:text-white">Systems &amp; Research Repositories</h2>
      <a href="/projects/" class="font-mono text-xs text-blue-800 dark:text-cyan-400 hover:underline">All projects &amp; talks →</a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {systems.map((p) => (
        <a
          href={p.href}
          target={p.external ? '_blank' : undefined}
          rel={p.external ? 'noreferrer' : undefined}
          class="group rounded-xl border border-stone-200 dark:border-zinc-800/80 p-4 bg-white/70 dark:bg-zinc-900/30 hover:border-blue-600/40 dark:hover:border-cyan-500/40 transition-colors"
        >
          <div class="flex items-center justify-between mb-1.5">
            <h3 class="font-semibold text-sm text-stone-900 dark:text-zinc-100 group-hover:text-blue-800 dark:group-hover:text-cyan-300">{p.name}</h3>
            <span class="font-mono text-[11px] text-stone-400">{p.external ? '↗' : '→'}</span>
          </div>
          <p class="text-xs sm:text-sm text-stone-600 dark:text-zinc-400 leading-relaxed mb-2">{p.desc}</p>
          <span class="font-mono text-[11px] text-blue-800 dark:text-cyan-400">{p.tag}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
