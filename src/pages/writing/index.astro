---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Writing — Yitae Jeong" description="Architecture notes and systems engineering essays.">
  <div class="mb-8">
    <p class="font-mono text-xs text-cyan-700 dark:text-cyan-400 mb-2">TECHNICAL WRITING</p>
    <h1 class="text-2xl sm:text-3xl font-semibold tracking-tight text-zinc-950 dark:text-white mb-2">Writing & Architecture Notes</h1>
    <p class="text-sm text-zinc-600 dark:text-zinc-400">
      Long-form design notes distilled from conference talks, debugging sessions, and infrastructure work.
    </p>
  </div>

  <div class="space-y-4">
    {posts.map((post) => (
      <a href={`/writing/${post.id}/`} class="block rounded-xl border border-zinc-200 dark:border-zinc-800/80 bg-white dark:bg-zinc-900/40 p-5 hover:border-cyan-500/50 transition-colors">
        <div class="flex items-center gap-2 font-mono text-xs text-zinc-500 dark:text-zinc-400 mb-1.5">
          <span>{post.data.date.toISOString().slice(0, 10)}</span>
          <span>·</span>
          <span>{post.data.category}</span>
          <span>·</span>
          <span>{post.data.readingTime}</span>
        </div>
        <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mb-1.5">{post.data.title}</h2>
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-3">{post.data.summary}</p>
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((t) => (
            <span class="font-mono text-[11px] text-zinc-500">#{t}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
