---
interface Props {
  title?: string;
  caption: string;
  wide?: boolean;
}
const { title, caption, wide = false } = Astro.props;
---

<figure class={`my-7 overflow-hidden rounded-xl border border-stone-200 dark:border-zinc-800 bg-stone-50/70 dark:bg-zinc-900/50 ${wide ? 'lg:-mx-6' : ''}`}>
  {title && (
    <div class="border-b border-stone-200/80 dark:border-zinc-800 px-4 py-2 font-mono text-[11px] uppercase tracking-wider text-stone-500 dark:text-zinc-400">
      {title}
    </div>
  )}
  <div class="p-4 sm:p-5 overflow-x-auto text-stone-800 dark:text-zinc-100 [&>svg]:w-full [&>svg]:h-auto [&>svg]:min-w-[540px] sm:[&>svg]:min-w-0">
    <slot />
  </div>
  <figcaption class="border-t border-stone-200/80 dark:border-zinc-800 px-4 py-2.5 text-xs text-stone-600 dark:text-zinc-400 leading-relaxed">
    {caption}
  </figcaption>
</figure>
