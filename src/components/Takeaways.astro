---
interface Props {
  items: string[];
  soWhat?: string;
}
const { items = [], soWhat } = Astro.props;
---

<aside class="my-6 rounded-xl border border-l-4 border-stone-200 dark:border-zinc-800 border-l-blue-700 dark:border-l-cyan-400 bg-stone-50 dark:bg-zinc-900/60 p-5">
  <p class="font-mono text-[11px] uppercase tracking-wider font-semibold text-blue-800 dark:text-cyan-400 mb-2.5">
    Key Takeaways
  </p>
  <ul class="space-y-2 text-sm leading-relaxed text-stone-800 dark:text-zinc-200">
    {items.map((item) => (
      <li class="flex items-start gap-2.5">
        <span class="mt-2 h-1.5 w-1.5 rounded-full bg-blue-700 dark:bg-cyan-400 shrink-0"></span>
        <span>{item}</span>
      </li>
    ))}
  </ul>
  {soWhat && (
    <div class="mt-3.5 pt-3 border-t border-stone-200/80 dark:border-zinc-800 text-xs sm:text-sm text-stone-700 dark:text-zinc-300">
      <strong class="font-mono text-[11px] uppercase tracking-wider text-stone-500 dark:text-zinc-400 mr-1.5">Practical Rule:</strong>
      <span>{soWhat}</span>
    </div>
  )}
</aside>
