---
interface Props {
  slug: string;
  title: string;
  date: Date;
  host: string;
  verdict: 'Supported' | 'Refuted' | 'Mixed' | 'Inconclusive';
  keyMetric: string;
  summary: string;
  takeaways?: string[];
  tags: string[];
  figures?: { src: string; alt: string; caption: string }[];
}

const {
  slug,
  title,
  date,
  host,
  verdict,
  keyMetric,
  summary,
  takeaways = [],
  tags,
  figures = [],
} = Astro.props;

const verdictStyle: Record<string, string> = {
  Supported: 'border-emerald-600/30 bg-emerald-500/10 text-emerald-800 dark:border-emerald-500/30 dark:text-emerald-300',
  Refuted: 'border-rose-600/30 bg-rose-500/10 text-rose-800 dark:border-rose-500/30 dark:text-rose-300',
  Mixed: 'border-amber-600/30 bg-amber-500/10 text-amber-800 dark:border-amber-500/30 dark:text-amber-300',
  Inconclusive: 'border-stone-400/40 bg-stone-500/10 text-stone-700 dark:text-zinc-400',
};

const dateStr = date.toISOString().slice(0, 10);
const thumb = figures[0];
const leadLine = takeaways[0] || summary;
---

<a
  href={`/experiments/${slug}/`}
  data-verdict={verdict}
  data-host={host}
  class="exp-card group block py-6 border-b border-stone-200/90 dark:border-zinc-800/80 hover:bg-stone-100/50 dark:hover:bg-zinc-900/35 -mx-3 px-3 rounded-xl transition-colors"
>
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-5">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-stone-500 dark:text-zinc-400 mb-2">
        <span>{dateStr}</span>
        <span>·</span>
        <span>{host}</span>
        <span class={`rounded-full border px-2 py-0.5 text-[11px] font-medium ${verdictStyle[verdict]}`}>
          {verdict}
        </span>
      </div>

      <h3 class="text-lg sm:text-xl font-semibold tracking-tight text-stone-950 dark:text-zinc-50 group-hover:text-blue-800 dark:group-hover:text-cyan-300 transition-colors mb-2 leading-snug">
        {title}
      </h3>

      <p class="text-sm text-stone-600 dark:text-zinc-400 leading-relaxed mb-2.5">
        {leadLine}
      </p>

      <p class="font-mono text-xs text-blue-800 dark:text-cyan-300 tabular-nums">
        {keyMetric}
      </p>

      {tags.length > 0 && (
        <div class="mt-2.5 flex flex-wrap gap-2">
          {tags.slice(0, 5).map((t) => (
            <span class="font-mono text-[11px] text-stone-400 dark:text-zinc-500">#{t}</span>
          ))}
        </div>
      )}
    </div>

    {thumb && (
      <div class="sm:w-52 shrink-0 rounded-lg border border-stone-200 dark:border-zinc-700/80 bg-white dark:bg-[#f6f6f3] p-1.5 shadow-sm overflow-hidden">
        <img
          src={thumb.src}
          alt={thumb.alt}
          loading="lazy"
          class="w-full h-28 object-contain"
        />
      </div>
    )}
  </div>
</a>
