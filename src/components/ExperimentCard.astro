---
interface Props {
  slug: string;
  title: string;
  date: Date;
  host: string;
  hypothesis: string;
  verdict: 'Supported' | 'Refuted' | 'Mixed' | 'Inconclusive';
  keyMetric: string;
  summary: string;
  tags: string[];
}

const { slug, title, date, host, hypothesis, verdict, keyMetric, summary, tags } = Astro.props;

const verdictStyle: Record<string, string> = {
  Supported: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300',
  Refuted: 'border-rose-500/30 bg-rose-500/10 text-rose-700 dark:text-rose-300',
  Mixed: 'border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-300',
  Inconclusive: 'border-zinc-500/30 bg-zinc-500/10 text-zinc-600 dark:text-zinc-400',
};

const dateStr = date.toISOString().slice(0, 10);
---

<a
  href={`/experiments/${slug}/`}
  data-verdict={verdict}
  data-host={host}
  class="exp-card block rounded-xl border border-zinc-200 dark:border-zinc-800/90 bg-white dark:bg-zinc-900/40 p-5 hover:border-cyan-500/50 transition-colors"
>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-2.5">
    <div class="flex items-center gap-2 font-mono text-xs text-zinc-500 dark:text-zinc-400">
      <span>{dateStr}</span>
      <span>·</span>
      <span class="rounded bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 text-zinc-700 dark:text-zinc-300">{host}</span>
    </div>
    <span class={`rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-medium ${verdictStyle[verdict]}`}>
      {verdict}
    </span>
  </div>
  <h3 class="text-base sm:text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-1.5">
    {title}
  </h3>
  <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-3 leading-relaxed">
    {summary}
  </p>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 rounded-lg bg-zinc-50 dark:bg-zinc-950/70 border border-zinc-200/70 dark:border-zinc-800/70 p-3 text-xs">
    <div>
      <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400">Hypothesis</span>
      <p class="text-zinc-700 dark:text-zinc-300 mt-0.5">{hypothesis}</p>
    </div>
    <div>
      <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-400">Key Metric</span>
      <p class="font-mono text-cyan-700 dark:text-cyan-300 mt-0.5 tabular-nums">{keyMetric}</p>
    </div>
  </div>
  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.map((t) => (
        <span class="font-mono text-[11px] text-zinc-500 dark:text-zinc-500">#{t}</span>
      ))}
    </div>
  )}
</a>
