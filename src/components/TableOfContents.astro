---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: Heading[];
  variant: 'mobile' | 'desktop';
}
const { headings = [], variant } = Astro.props;
const filtered = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{filtered.length > 0 && variant === 'mobile' && (
  <details class="lg:hidden my-5 rounded-xl border border-stone-200 dark:border-zinc-800 bg-stone-50 dark:bg-zinc-900/40 px-4 py-3 text-sm">
    <summary class="cursor-pointer font-mono text-xs font-medium text-stone-700 dark:text-zinc-300 select-none">
      On this page ({filtered.length} sections)
    </summary>
    <ul class="mt-2.5 space-y-1.5 border-t border-stone-200/70 dark:border-zinc-800 pt-2.5 text-xs">
      {filtered.map((h) => (
        <li class={h.depth === 3 ? 'pl-3' : ''}>
          <a href={`#${h.slug}`} class="text-stone-600 dark:text-zinc-400 hover:text-blue-700 dark:hover:text-cyan-400">
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </details>
)}

{filtered.length > 0 && variant === 'desktop' && (
  <aside class="hidden lg:block sticky top-20 self-start pl-4 border-l border-stone-200 dark:border-zinc-800">
    <p class="font-mono text-[11px] uppercase tracking-wider text-stone-500 dark:text-zinc-400 mb-3">
      Contents
    </p>
    <nav aria-label="Table of contents">
      <ul class="space-y-2 text-xs leading-snug">
        {filtered.map((h) => (
          <li class={h.depth === 3 ? 'pl-3' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class="toc-link block py-0.5 text-stone-500 dark:text-zinc-400 hover:text-stone-900 dark:hover:text-zinc-100 transition-colors"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <script is:inline>
      const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
      const headingEls = tocLinks
        .map((a) => document.getElementById(a.getAttribute('data-toc-link')))
        .filter(Boolean);
      if (headingEls.length > 0 && 'IntersectionObserver' in window) {
        const setActive = (id) => {
          tocLinks.forEach((a) => {
            const match = a.getAttribute('data-toc-link') === id;
            a.classList.toggle('font-medium', match);
            a.classList.toggle('text-blue-700', match);
            a.classList.toggle('dark:text-cyan-400', match);
          });
        };
        const obs = new IntersectionObserver(
          (entries) => {
            const visible = entries.find((e) => e.isIntersecting);
            if (visible?.target?.id) setActive(visible.target.id);
          },
          { rootMargin: '-80px 0px -65% 0px', threshold: 0.1 }
        );
        headingEls.forEach((el) => obs.observe(el));
      }
    </script>
  </aside>
)}
